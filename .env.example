# Optional server-side Supabase configuration for the REST API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used in verification and password-reset links
APP_URL=http://localhost:3000

# Optional SMTP used by the server to send admin decision notifications.
# Signup verification and password-reset emails are sent by Supabase Auth.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required for administrator registration. Use a unique random value of at least 32 characters.
# Keep this only in .env and rotate it after each administrator account is registered.
ADMIN_INVITE_CODE=

# Runtime
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
